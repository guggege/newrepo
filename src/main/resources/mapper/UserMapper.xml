<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yf.dao.UserMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.yf.entity.User">
        <id column="id" property="id" />
        <result column="username" property="username" />
        <result column="password" property="password" />
        <result column="email" property="email" />
        <result column="phone" property="phone" />
        <result column="status" property="status" />
        <result column="avatar" property="avatar" />
        <result column="deleted" property="deleted" />
        <result column="name" property="name" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, username, password, email, phone, status, avatar, deleted,name
    </sql>

    <select id="getRoleNamesByUserId" parameterType="Integer" resultType="String">
        SELECT
            b.role_name
        FROM x_user_role a,x_role b
        WHERE a.`user_id` = #{userId}
          AND a.`role_id` = b.`role_id`
    </select>


</mapper>
